<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Payment Acquirer -->
    <record id="payment_acquirer_birrlink" model="payment.acquirer">
        <field name="name">BirrLink</field>
        <field name="provider">birrlink</field>
        <field name="view_template_id" ref="redirect_form"/>
        <field name="save_token">always</field>
        <field name="fees_active">0</field>
        <field name="auto_confirm">confirm_so</field>
        <field name="birrlink_public_key">dummy_key</field>
        <field name="birrlink_secret_key">dummy_secret</field>
        <field name="birrlink_webhook_secret">dummy_webhook</field>
    </record>

</odoo>